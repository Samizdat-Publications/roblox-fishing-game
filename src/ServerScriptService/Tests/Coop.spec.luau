-- Playing together (leg 3, N4): shared-catch money, Double Hookup, buddy loan, chum.
-- Written 11/27/2026; UNVERIFIED in Studio.
return function(t, Shared)
	local Coop = require(Shared.Coop)

	t.test("a shared catch: the angler keeps full price, the helper gets 10 percent on top", function()
		local angler, helpers = Coop.shareCatch(31, 1, true)
		t.eq(angler, 31, "full price")
		t.eq(#helpers, 1)
		t.eq(helpers[1], 3, "10 percent, rounded")
		t.eq(Coop.assistBonus(4), 1, "never less than a coin for a real fish")
		t.eq(Coop.assistBonus(85), 9)
		t.eq(Coop.assistBonus(0), 0, "nothing for nothing")
		local a2, h2 = Coop.shareCatch(50, 2, true)
		t.eq(a2, 50)
		t.eq(h2[1] + h2[2], 10, "each helper gets their own 10 percent")
	end)

	t.test("with the switch off a team catch splits evenly, as before", function()
		local angler, helpers = Coop.shareCatch(31, 1, false)
		t.eq(angler, 16, "the odd coin to the angler")
		t.eq(helpers[1], 15)
		t.eq(angler + helpers[1], 31, "nothing made or lost")
	end)

	t.test("Double Hookup pays 25 percent each only when both land", function()
		local p = Coop.newPair("A", "B")
		t.eq(Coop.pairResult(p, "A", "won", 40), nil, "waiting for B")
		local pay = Coop.pairResult(p, "B", "won", 20) :: any
		t.ok(pay ~= nil, "resolved")
		t.eq(pay.A, 10, "A: 25 percent of 40")
		t.eq(pay.B, 5, "B: 25 percent of 20")
		local q = Coop.newPair("A", "B")
		Coop.pairResult(q, "A", "won", 40)
		local none = Coop.pairResult(q, "B", "lost") :: any
		t.ok(none ~= nil and next(none) == nil, "one lost: no bonus")
		t.eq(Coop.pairResult(q, "A", "won", 40), nil, "a side counts once")
		t.eq(Coop.pairResult(q, "C", "won", 40), nil, "a stranger doesn't count")
	end)

	t.test("buddy loan: a passenger fishes with the owner's tackle when it's better, never worse", function()
		local rod, braid = Coop.loanTackle("Willow", false, "Graphite", true)
		t.eq(rod, "Graphite", "the owner's rod")
		t.eq(braid, true, "and braid")
		local rod2, braid2 = Coop.loanTackle("Graphite", false, "Willow", false)
		t.eq(rod2, "Graphite", "keeps their own better rod")
		t.eq(braid2, false)
		local rod3 = Coop.loanTackle("Fiberglass", true, nil, nil)
		t.eq(rod3, "Fiberglass", "no owner: their own")
	end)

	t.test("creek buddy: within 20 studs of a pass holder", function()
		t.ok(Coop.creekBuddy(Vector3.new(0, 0, 0), { Vector3.new(15, 0, 5) }), "close")
		t.ok(not Coop.creekBuddy(Vector3.new(0, 0, 0), { Vector3.new(30, 0, 0) }), "too far")
		t.ok(not Coop.creekBuddy(Vector3.new(0, 0, 0), {}), "nobody")
	end)

	t.test("chum: 25 seconds of quicker bites, then 90 seconds to the next", function()
		t.ok(Coop.chumReady(nil, 0), "ready at first")
		t.ok(Coop.chumActive(100, 110), "boiling at 10 s")
		t.ok(not Coop.chumActive(100, 126), "over at 26 s")
		t.ok(not Coop.chumReady(100, 150), "not ready at 50 s")
		t.eq(Coop.chumWait(100, 150), 40, "40 s to go")
		t.ok(Coop.chumReady(100, 190), "ready at 90 s")
		t.eq(Coop.CHUM_BITE, 0.75, "a quarter sooner")
	end)
end
